{
  "name": "2.playwright-training",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "gen:types":       "openapi-typescript ./swagger.json -o ./src/api-client/Api.ts",
    "gen:docs":        "ts-node scripts/swagger-to-md.ts",

    "setup":           "npx playwright test --project=setup",

    "test:ui":         "npx playwright test tests/ui/",
    "test:api":        "npx playwright test tests/api/",
    "test:e2e":        "npx playwright test tests/e2e/",

    "test:smoke":      "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",

    "test:headed":     "npx playwright test --headed",
    "test:debug":      "npx playwright test --debug",

    "test:all":        "npx playwright test",

    "report":          "npx playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "openapi-typescript": "^7.13.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "pg": "^8.20.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  }
}
